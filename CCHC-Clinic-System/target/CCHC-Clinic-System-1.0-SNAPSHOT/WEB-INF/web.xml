<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Application Name -->
    <display-name>CCHC Clinic System</display-name>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Custom Tag Library Configuration -->
    <jsp-config>
        <taglib>
            <taglib-uri>/WEB-INF/tlds/staff-taglib.tld</taglib-uri>
            <taglib-location>/WEB-INF/tlds/staff-taglib.tld</taglib-location>
        </taglib>
    </jsp-config>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout> <!-- 30 minutes session timeout -->
    </session-config>

    <!-- Error Page Configuration -->
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/common/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/common/error.jsp</location>
    </error-page>

</web-app>